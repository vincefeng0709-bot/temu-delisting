# Temu 卖家中心地址。登录不走这里的账号密码 —— 详见 README「首次登录」一节，
# 登录必须在你正常浏览器里完成，再用 `temu-delisting import-cookies` 导入。
TEMU_SELLER_URL=https://seller.kuajingmaihuo.com
TEMU_USERNAME=
TEMU_PASSWORD=

# Playwright
HEADLESS=false
# 用真实安装的 Chrome 正式版而不是 Playwright 自带的精简内核（需要先执行一次
# `playwright install chrome`）。留空则退回用自带内核。
BROWSER_CHANNEL=chrome
# 每一步操作之间人为加的停顿（毫秒），方便肉眼看清楚每一步在做什么。
# 联调/测试阶段建议设 300~800，正式稳定运行后可以改回 0（不停顿，跑最快）。
SLOW_MO_MS=500

# 数据根目录（一般不用改；每个账号的数据库/登录态/导出/日志都在这下面按
# 账号 ID 分目录存放，见 accounts.py）
# DATA_ROOT=data

# 客服机器人等待下架确认的超时时间（秒）
CHAT_TIMEOUT_SECONDS=15
# 处理下一个 SKC 前主动停顿的秒数，避免连续快速触发客服会话导致响应变慢
CHAT_COOLDOWN_SECONDS=5
