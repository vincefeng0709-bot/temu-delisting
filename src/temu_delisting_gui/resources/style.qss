/* 干净简约的暖白配色，参考 Claude 产品的视觉语言：暖白背景、克制的边框线、
   一个暖色调强调色（用在主按钮/进度条/选中态上），不用大面积高饱和色块。 */

QWidget {
    background-color: #FAF9F5;
    color: #3D3929;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #FAF9F5;
}

QLabel#sectionTitle {
    font-size: 14px;
    font-weight: 600;
    color: #3D3929;
    padding-bottom: 2px;
}

QLabel#hintLabel {
    color: #83807A;
    font-size: 12px;
}

QComboBox, QLineEdit, QTextEdit, QPlainTextEdit, QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #E5E1D8;
    border-radius: 8px;
    padding: 6px 10px;
    selection-background-color: #F0E6DE;
}

QComboBox:hover, QLineEdit:hover, QDateEdit:hover, QTextEdit:hover {
    border-color: #C15F3C;
}

QComboBox:disabled, QPushButton:disabled, QDateEdit:disabled {
    background-color: #F1EFE9;
    color: #B5B2AB;
    border-color: #E5E1D8;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    border: none;
    border-left: 1px solid #E5E1D8;
    width: 28px;
}

QComboBox::down-arrow {
    image: url({ICONS_DIR}/chevron-down.png);
    width: 10px;
    height: 6px;
}

QDateEdit::drop-down {
    border: none;
    border-left: 1px solid #E5E1D8;
    width: 22px;
}

QDateEdit::down-arrow {
    image: url({ICONS_DIR}/chevron-down.png);
    width: 10px;
    height: 6px;
}

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E5E1D8;
    border-radius: 8px;
    padding: 6px 16px;
    color: #3D3929;
}

QPushButton:hover {
    border-color: #C15F3C;
    color: #C15F3C;
}

QPushButton:pressed {
    background-color: #F5F1EA;
}

QPushButton#primaryButton {
    background-color: #C15F3C;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #A94F30;
    color: #FFFFFF;
}

QPushButton#primaryButton:disabled {
    background-color: #E8CFC2;
    color: #FFFFFF;
    border: none;
}

QPushButton#dangerButton {
    background-color: #FFFFFF;
    color: #B3261E;
    border: 1px solid #E8B4AF;
}

QPushButton#dangerButton:hover {
    background-color: #FBEAE8;
    border-color: #B3261E;
    color: #B3261E;
}

QPushButton#dangerButton:disabled {
    color: #D9B8B5;
    border-color: #F2E3E1;
}

QProgressBar {
    background-color: #FFFFFF;
    border: 1px solid #E5E1D8;
    border-radius: 8px;
    text-align: center;
    height: 22px;
    color: #3D3929;
}

QProgressBar::chunk {
    background-color: #C15F3C;
    border-radius: 7px;
}

QPlainTextEdit#logPanel {
    background-color: #262624;
    color: #D8D4C8;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 12px;
    border-radius: 10px;
    border: 1px solid #3D3929;
}

QTabWidget::pane {
    border: 1px solid #E5E1D8;
    border-radius: 0 10px 10px 10px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F5F3EE;
    color: #83807A;
    padding: 7px 18px;
    border: 1px solid #E5E1D8;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #3D3929;
    font-weight: 600;
    border-color: #E5E1D8;
    border-bottom: 2px solid #C15F3C;
}

QTabBar::tab:hover {
    color: #3D3929;
}

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E1D8;
    border-radius: 8px;
    gridline-color: #F0EEE7;
    selection-background-color: #F5EDE5;
    selection-color: #3D3929;
}

QTableWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #F5F3EE;
    color: #3D3929;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #E5E1D8;
    font-weight: 600;
}

QStatusBar {
    background-color: #F5F3EE;
    color: #83807A;
    border-top: 1px solid #E5E1D8;
}

QCheckBox {
    spacing: 6px;
}

QMessageBox {
    background-color: #FAF9F5;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #D9D5CA;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #C1BCAE;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
